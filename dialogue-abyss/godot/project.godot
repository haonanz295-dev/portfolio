; Dialogue Abyss native Godot foundation
config_version=5

[application]
config/name="Dialogue Abyss Native"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.015,0.055,0.075,1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
sonar={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
photo_mode={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
toggle_follow={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":84)]}
cancel={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[audio]
driver/enable_input=false
